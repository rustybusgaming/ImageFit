{
  "name": "imagefit",
  "private": true,
  "version": "1.1.1",
  "packageManager": "pnpm@11.20.0",
  "description": "ImageFit desktop and web app for resizing and exporting images and videos.",
  "author": "rustybusgaming",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:desktop": "tsc -b && vite build --base=./",
    "desktop": "pnpm run build:desktop && electron .",
    "desktop:package": "pnpm run build:desktop && electron-builder --publish never",
    "desktop:package:linux": "pnpm run build:desktop && electron-builder --linux appimage --publish never",
    "desktop:package:mac": "pnpm run build:desktop && electron-builder --mac dmg zip --publish never",
    "desktop:package:win": "pnpm run build:desktop && electron-builder --win nsis portable --publish never",
    "lint": "eslint .",
    "test": "node --test test/**/*.test.cjs",
    "preview": "vite preview"
  },
  "main": "desktop/main.cjs",
  "build": {
    "appId": "com.imagefit.desktop",
    "productName": "ImageFit",
    "icon": "build/icon.svg",
    "publish": [
      {
        "provider": "github",
        "owner": "rustybusgaming",
        "repo": "ImageFit"
      }
    ],
    "fileAssociations": [
      {
        "ext": [
          "png",
          "apng",
          "jpg",
          "jpeg",
          "gif",
          "webp",
          "svg",
          "avif",
          "heic",
          "heif",
          "bmp",
          "ico",
          "tif",
          "tiff",
          "psd",
          "qoi",
          "tga",
          "dds",
          "jp2",
          "mp4",
          "webm",
          "mov",
          "m4v",
          "avi",
          "mkv"
        ],
        "name": "ImageFit media file",
        "role": "Editor"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "node_modules/ffmpeg-static",
        "to": "ffmpeg"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "category": "public.app-category.graphics-design",
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ImageFit"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    }
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "electron-updater": "^6.8.11",
    "ffmpeg-static": "^5.3.0",
    "file-saver": "^2.0.5",
    "jszip": "^3.10.2",
    "libheif-js": "^1.23.5",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-dropzone": "^17.0.0",
    "react-easy-crop": "^6.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^43.8.12",
    "electron-builder": "^26.18.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8"
  }
}
