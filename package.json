{
  "name": "imagefit",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@11.20.0",
  "description": "ImageFit desktop and web app for resizing and exporting images and videos.",
  "author": "rustybusgaming",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:desktop": "tsc -b && vite build --base=./",
    "desktop": "pnpm run build:desktop && electron .",
    "desktop:package": "pnpm run build:desktop && electron-builder --publish never",
    "desktop:package:linux": "pnpm run build:desktop && electron-builder --linux appimage --publish never",
    "desktop:package:win": "pnpm run build:desktop && electron-builder --win nsis portable --publish never",
    "lint": "eslint .",
    "test": "node --test test/**/*.test.cjs",
    "preview": "vite preview"
  },
  "main": "desktop/main.cjs",
  "build": {
    "appId": "com.imagefit.desktop",
    "productName": "ImageFit",
    "icon": "build/icon.svg",
    "publish": [
      {
        "provider": "github",
        "owner": "rustybusgaming",
        "repo": "ImageFit"
      }
    ],
    "fileAssociations": [
      {
        "ext": [
          "png", "jpg", "jpeg", "gif", "webp", "svg", "mp4", "webm", "mov", "m4v", "avi", "mkv"
        ],
        "name": "ImageFit media file",
        "role": "Editor"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "node_modules/ffmpeg-static",
        "to": "ffmpeg"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ImageFit"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    }
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0",
    "file-saver": "^2.0.5",
    "jszip": "^3.10.1",
    "lucide-react": "^1.25.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-dropzone": "^17.0.0",
    "react-easy-crop": "^6.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.1"
  }
}
