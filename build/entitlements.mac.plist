<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- V8 compiles JavaScript at runtime, which the hardened runtime blocks by default. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!--
      ImageFit spawns the FFmpeg binary bundled in Contents/Resources. Under the hardened
      runtime a signed app will not load or execute a nested binary signed with a different
      identity, so library validation has to be relaxed for the encoder to start.
    -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Reading and writing the user's chosen source and output folders. -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
  </dict>
</plist>
