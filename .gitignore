# Dependencies and package-manager state
node_modules/
.pnpm-store/

# Build and test output
dist/
dist-ssr/
release/
coverage/
.nyc_output/
*.tsbuildinfo

# Keep source packaging assets while excluding generated build content.
# icon.png is rendered from icon.svg but has to be committed: electron-builder cannot read
# SVG when producing macOS .icns, and CI packages from a clean checkout.
build/*
!build/icon.svg
!build/icon.png
!build/entitlements.mac.plist

# Environment files and signing material
.env
.env.*
!.env.example
*.local
*.pfx
*.p12
*.pem
*.key
*.cer

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor and operating-system files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?